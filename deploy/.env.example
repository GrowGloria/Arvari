# Скопируйте в .env рядом с docker-compose.yml и заполните.
# Файл .env НЕ коммитить — в нём секреты.

# Слово-ключ входа Мастера в редактор. Смените на свой!
ARVARI_PASSPHRASE=придумайте-своё-слово

# Секрет подписи токена. Длинная случайная строка (32+ символа).
# Сгенерировать: openssl rand -hex 32
ARVARI_SECRET=замените-на-длинную-случайную-строку

# Публичный адрес сайта — для красивых ссылок и картинок в превью (OG).
# Без него превью будут ссылаться на технический адрес …ts.net (тоже работает).
ARVARI_PUBLIC_URL=https://arvariwiki.ru
